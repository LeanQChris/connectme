{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": false,
    "jsx": "preserve",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@connectme/contracts": ["./packages/contracts/src/index.ts"],
      "@connectme/crypto": ["./packages/crypto/src/index.ts"],
      "@connectme/database": ["./packages/database/src/index.ts"],
      "@connectme/channels": ["./packages/channels/src/index.ts"],
      "@/*": ["./apps/web/*"]
    }
  },
  "include": [
    "packages/*/src/**/*",
    "apps/api/src/**/*",
    "apps/api/test/**/*",
    "apps/worker/src/**/*",
    "apps/web/app/**/*",
    "apps/web/components/**/*",
    "apps/web/core/**/*",
    "apps/web/modules/**/*",
    "apps/web/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "**/dist",
    "**/.next"
  ]
}
