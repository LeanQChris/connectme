# Copy this file to .env and fill in the values. Never commit .env.

# Meta app secret (App Dashboard -> Settings -> Basic -> App secret).
# Used to verify the X-Hub-Signature-256 header on webhook requests.
APP_SECRET= a8596252d2ce80cf6ae05c41d32ccea6

# Any string you invent. You type the same value into Meta's webhook settings.
WEBHOOK_VERIFY_TOKEN=

# Graph API version used for every Meta API call.
GRAPH_VERSION=v21.0

# WhatsApp Cloud API. App Dashboard -> WhatsApp -> API Setup.
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=

# Meta App ID (numeric). Only needed for outbound WhatsApp attachments:
# the resumable upload endpoint is addressed by app id.
META_APP_ID=

# Facebook Page access token. Leave empty until a Page is connected;
# Messenger is skipped gracefully while this is empty.
FB_PAGE_ACCESS_TOKEN= EAAWOgg1i4VoBStJboyKUdbUf0mNsWwZA6Wv3XQFVEyWpHNWMpbPS3TLUFrgpFZAIXeFkbl7fYTCUZBYqXkLYw7ETnMlolPsLGZAdke4SR30NnhuT8JQ4xahjCMkugmCg8OYNvCdEMiZAaOL3g3bg75z16IBKpZCnHeJIxT6Paaje88wHxctTseP5nlvH7TeKytZCcJVJMdgmsYoyZA4urZAZCeXE4TZBAZDZD

# Telegram Bot API token. Get from @BotFather on Telegram.
# Leave empty until you create a bot.
TELEGRAM_BOT_TOKEN=8682109054:AAHOsU3VPS_iIJ00Tex02wZutU7dZ5HiVkM

# Shared password for the dashboard.
ADMIN_PASSWORD=Password@123

# Signs the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=d6425a735dabfaaa2fd23ac4f339d05a91a4b686fabc6c20978175c2254bb8b4

# Storage backend. Leave both unset locally: the store then uses data/inbox.json.
# Set both on Vercel: the filesystem is read-only there, so the store keeps the
# whole inbox in Vercel KV instead. Create the store with:
#   npx vercel kv create connectme
# then link it to the project (Storage tab) or `vercel env add` both values.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Reserved for Prisma + Postgres. Not used yet.
DATABASE_URL="file:./dev.db"
