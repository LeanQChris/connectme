# Copy this file to .env and fill in the values. Never commit .env.

# ---------------------------------------------------------------- app level --
# These three are the only values the whole app needs. Provider tokens are NOT
# here any more: each user enters their own in /settings and they are encrypted
# with ENCRYPTION_KEY before being stored.

# Clerk keys. `npx clerk init` writes dev keys to .env.local; production keys come
# from the Clerk dashboard and belong here (or in your host's secret store).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Master key protecting every user's provider tokens (AES-256-GCM).
# Generate with: openssl rand -hex 32
# Rotating this invalidates all stored credentials.
ENCRYPTION_KEY=

# Graph API version used when a user does not override it in /settings.
GRAPH_VERSION=v21.0

# Address shown as the contact point on /privacy and /about.
CONTACT_EMAIL=chris.leanq@gmail.com

# ---------------------------------------------------- 1-Click Meta OAuth --
# Meta Developer App credentials for 1-click Facebook, Instagram, & WhatsApp.
# Get these from https://developers.facebook.com -> App Settings -> Basic.
META_APP_ID=
META_APP_SECRET=
# Custom verify token entered when configuring Webhooks in the Meta App dashboard:
META_WEBHOOK_VERIFY_TOKEN=
# Public base URL of your app (used for OAuth redirect URI resolution):
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Storage backend. Leave both unset locally: the store then uses data/inbox.json.
# Set both on Vercel: the filesystem is read-only there, so the store keeps the
# whole inbox in Vercel KV instead. Create the store with:
#   npx vercel kv create connectme
# then link it to the project (Storage tab) or `vercel env add` both values.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Reserved for Prisma + Postgres. Not used yet.
DATABASE_URL="file:./dev.db"
