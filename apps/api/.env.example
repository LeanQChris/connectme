# ConnectMe API (apps/api) — copy to apps/api/.env.local or .env
# Provider tokens (WhatsApp/Meta/Telegram/Discord) are NOT here: each tenant
# enters their own in /settings and they are encrypted with ENCRYPTION_KEY.

# ---------------------------------------------------------------- core --
NODE_ENV=development
API_PORT=8081

# Postgres (system of record). See docker-compose.yml.
# Host port defaults to 5434 to avoid clashing with other local stacks.
DATABASE_URL=postgres://postgres:postgres@localhost:5434/connectme

# Redis — required for webhook idempotency locks, rate limiting and the
# scheduling queue. Use redis:// or rediss:// (auth/TLS/db are honored).
# Scheduling is disabled (enqueue returns 503) if Redis is unreachable, and
# webhook dedup fails closed.
REDIS_URL=redis://localhost:6381
# Optional host/port fallback used when REDIS_URL is unset:
REDIS_HOST=localhost
REDIS_PORT=6381

# Master key protecting every tenant's provider tokens (AES-256-GCM).
# REQUIRED — the API and worker refuse to start without it (no dev fallback).
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ------------------------------------------------------------- auth (Clerk) --
# Secret key of the same Clerk application the web app uses. The API verifies
# the session token forwarded by the web proxy and derives the tenant from it.
CLERK_SECRET_KEY=

# Extra secret mixed into signed OAuth state. Falls back to ENCRYPTION_KEY.
OAUTH_STATE_SECRET=

# Browser origins allowed to call the API (comma-separated). Defaults to
# NEXT_PUBLIC_APP_URL (+ http://localhost:3001 outside production).
CORS_ORIGINS=

# ------------------------------------------------------------ webhooks --
# Discord application public key (hex) used to verify interaction signatures
# when no per-tenant key is stored in /settings.
DISCORD_PUBLIC_KEY=

# Extra hosts the media proxy may download from (comma-separated). Meta/FB CDN
# hosts and S3_PUBLIC_BASE_URL are allowed automatically.
MEDIA_ALLOWED_HOSTS=

# Embeddable widget: comma-separated origins or bare hostnames allowed to use
# the widget (bare hostnames also cover their subdomains), e.g.
# https://www.example.com,example.com. Unset accepts every origin — set it to
# stop any other site from opening a session against your tenant. Checked when a
# session is created and again on every message and upload.
WIDGET_ALLOWED_ORIGINS=

# ------------------------------------------------------------ Meta / Graph --
# Graph API version used when a tenant does not override it.
NEXT_PUBLIC_META_GRAPH_VERSION=v22.0

# 1-Click Meta OAuth (Facebook / Instagram / WhatsApp). From the Meta App
# dashboard. OAuth is disabled when these are unset.
META_APP_ID=
META_APP_SECRET=
META_CLIENT_ID=
META_CLIENT_SECRET=

# Verify token entered when configuring the Meta webhook in the app dashboard.
META_WEBHOOK_VERIFY_TOKEN=

# Public base URL of the web app (used to build OAuth redirect URIs).
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ----------------------------------------------------- media storage (S3/R2) --
# Required before Instagram / Page media posts work: Meta fetches media from a
# public URL. Set these to enable POST /api/media/presign.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
