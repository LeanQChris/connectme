# ConnectMe Worker (apps/worker) — copy to apps/worker/.env.local or .env
# Background jobs: inbound webhook processing + scheduled post/message delivery.

# ---------------------------------------------------------------- core --
NODE_ENV=development

# Postgres — must match apps/api. Run migrations before starting the worker.
DATABASE_URL=postgres://postgres:postgres@localhost:5434/connectme

# Redis — REQUIRED. Delayed scheduling jobs live here; there is no memory
# fallback, so the worker cannot deliver scheduled items without Redis.
# Use redis:// or rediss:// (auth/TLS/db index are honored).
REDIS_URL=redis://localhost:6381
# Optional host/port fallback used when REDIS_URL is unset:
REDIS_HOST=localhost
REDIS_PORT=6381

# Master key used to decrypt tenant provider tokens before sending.
# MUST be the same value as apps/api's ENCRYPTION_KEY.
ENCRYPTION_KEY=

# Graph API version for outbound Meta sends (posts + messages).
NEXT_PUBLIC_META_GRAPH_VERSION=v22.0
