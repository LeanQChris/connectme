# ConnectMe Web (apps/web) — copy to apps/web/.env.local
# Next.js app: inbox UI, settings, scheduling. Talks to apps/api.

# ---------------------------------------------------------------- core --
# URL of the NestJS API. Used for the /api/* proxy and the socket connection.
NEXT_PUBLIC_API_URL=http://localhost:8081
# Optional server-side override for the API proxy (falls back to NEXT_PUBLIC_API_URL).
API_URL=http://localhost:8081

# Public base URL of this web app (OAuth redirects, links).
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ------------------------------------------------------------- Clerk auth --
# Google-only sign-in. Get these from the Clerk dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# ------------------------------------------------------------ misc --
# Contact address shown on /privacy and /about.
CONTACT_EMAIL=
