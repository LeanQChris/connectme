{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "db:sync": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "schema:sync": {
      "cache": false
    },
    "migration:run": {
      "cache": false
    },
    "migration:generate": {
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
