{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      // `@connectme/*` packages resolve to their (gitignored) dist/, and tsc
      // emits nothing, so a clean checkout cannot typecheck until the
      // dependencies have been built. `^check-types` alone typechecks them
      // without ever producing dist, which is what broke CI on a fresh
      // `npm ci`. `test` already had the same requirement.
      "dependsOn": ["^check-types", "^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "db:sync": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "schema:sync": {
      "cache": false
    },
    "migration:run": {
      "cache": false
    },
    "migration:generate": {
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
