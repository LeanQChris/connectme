{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "passThroughEnv": [
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
        "DATABASE_URL"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      // `@connectme/*` packages resolve to their (gitignored) dist/, and tsc
      // emits nothing, so a clean checkout cannot typecheck until the
      // dependencies have been built. `^check-types` alone typechecks them
      // without ever producing dist, which is what broke CI on a fresh
      // `npm ci`. `test` already had the same requirement.
      "dependsOn": ["^check-types", "^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      // Lets the DB integration specs reach a real Postgres when one is
      // provided (CI has a postgres service) instead of skipping.
      "passThroughEnv": [
        "DATABASE_URL",
        "REDIS_URL",
        "ENCRYPTION_KEY",
        "CLERK_SECRET_KEY"
      ]
    },
    "db:sync": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL", "DB_SYNCHRONIZE", "NODE_ENV"]
    },
    "db:migrate": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL", "DB_SYNCHRONIZE", "NODE_ENV"]
    },
    "schema:sync": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL", "DB_SYNCHRONIZE", "NODE_ENV"]
    },
    "migration:run": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL", "DB_SYNCHRONIZE", "NODE_ENV"]
    },
    "migration:generate": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL", "DB_SYNCHRONIZE", "NODE_ENV"]
    },
    "clean": {
      "cache": false
    }
  }
}
