{
  "name": "connectme-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.11.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@connectme/web",
    "dev:api": "turbo run dev --filter=@connectme/api",
    "dev:worker": "turbo run dev --filter=@connectme/worker",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check-types": "turbo run check-types",
    "db:sync": "turbo run schema:sync --filter=@connectme/database",
    "db:migrate": "turbo run migration:run --filter=@connectme/database",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "turbo": "^2.4.4",
    "typescript": "^5",
    "typescript-eslint": "^8.71.0"
  }
}
