# ConnectMe — VPS production environment.
#
#   cp .env.production.example .env.production
#   openssl rand -hex 32          # for ENCRYPTION_KEY, OAUTH_STATE_SECRET, DB password
#   chmod 600 .env.production
#
# Then:
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
#
# This file is read by Compose (for interpolation and build args) AND injected
# into api/worker via `env_file`. Both the API and the worker receive it, which
# is what guarantees they share one ENCRYPTION_KEY — they decrypt the same
# tenant provider tokens, so a mismatch makes the worker fail to read every
# stored credential.
#
# .env.production must never be committed. It is covered by .gitignore.

# ------------------------------------------------------------------ domain --
# The single public origin. A DNS A record must point at this VPS before the
# first `up`, because Caddy obtains its TLS certificate on first boot.
APP_DOMAIN=app.example.com
# Used by Caddy for the ACME account and expiry notices.
ACME_EMAIL=you@example.com

# --------------------------------------------------------------- web (build) --
# NEXT_PUBLIC_* values are inlined at BUILD time. Changing any of them requires
# `docker compose ... up -d --build web`, not a restart.
# Must be the PUBLIC origin: the browser opens its Socket.IO connection to this
# value directly, and the page CSP allows that origin for connect-src.
NEXT_PUBLIC_API_URL=https://app.example.com
NEXT_PUBLIC_APP_URL=https://app.example.com

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# ------------------------------------------------------------------ Clerk --
# From the Clerk dashboard. The publishable key is also baked into the web
# image at build time; the secret key is read by the API and web at runtime.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_replace_me
CLERK_SECRET_KEY=sk_live_replace_me

# ----------------------------------------------------------------- secrets --
# Master key protecting every tenant's provider tokens (AES-256-GCM).
# REQUIRED. Generate with: openssl rand -hex 32
# Rotating this invalidates every stored tenant credential.
ENCRYPTION_KEY=
# Extra secret mixed into signed OAuth state. Strongly recommended to differ
# from ENCRYPTION_KEY; a weak ENCRYPTION_KEY would otherwise also weaken the
# OAuth state that carries tenant binding.
OAUTH_STATE_SECRET=

# ---------------------------------------------------------------- postgres --
# Only used to initialize the postgres container. The apps connect over the
# internal Docker network as postgres:5432, never via these host ports.
#
# DATABASE_URL is NOT set here: docker-compose.prod.yml derives it from these
# three values so the password is defined exactly once. Do not add a
# DATABASE_URL of your own — if you override it, it must use the host name
# `postgres`, not `localhost`, or the app will silently fall back to its
# built-in default and fail to connect.
#
# Use a hex password (openssl rand -hex 32) — it becomes part of a connection
# URL, so characters like @ : / # would need percent-encoding.
POSTGRES_USER=connectme
POSTGRES_PASSWORD=
POSTGRES_DB=connectme

# ------------------------------------------------------------------- redis --
# Internal network address. Never publish this to the internet.
REDIS_URL=redis://redis:6379

# -------------------------------------------------------------------- meta --
# Graph API version used when a tenant has not overridden it.
NEXT_PUBLIC_META_GRAPH_VERSION=v22.0
# Verify token you enter when configuring the Meta webhook in the app dashboard.
META_WEBHOOK_VERIFY_TOKEN=
# 1-Click Meta OAuth credentials. OAuth is simply disabled while these are unset.
META_APP_ID=
META_APP_SECRET=
META_CLIENT_ID=
META_CLIENT_SECRET=
# Discord application public key (hex), used for interaction verification when
# no tenant has stored one in /settings.
DISCORD_PUBLIC_KEY=

# --------------------------------------------------------- media storage ----
# Required before Instagram / Page media posts work: Meta fetches media from a
# public URL, so a local disk is not enough. Cloudflare R2 is the cheapest fit.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ------------------------------------------------------------------- misc --
# Extra hosts the media proxy may download from (comma-separated). Meta/FB CDN
# hosts and S3_PUBLIC_BASE_URL are allowed automatically.
MEDIA_ALLOWED_HOSTS=
# Contact address shown on /privacy and /about.
CONTACT_EMAIL=support@example.com
